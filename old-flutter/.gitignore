/android/local.properties

# Firmas — el repo es privado y la app es de prueba, así que la clave SÍ se
# versiona a propósito: si cada build de Actions firmara con una clave de
# debug efímera, Android rechazaría la actualización y habría que
# desinstalar la app para instalarla. Con la misma clave el APK se instala
# encima del anterior.
.env
.env.*
android/app/google-services.json
android/app/*.json

# Hive / datos locales de la app
*.hive
*.lock
!pubspec.lock

# Widget Preview related
.widget_preview/

# Misc de CI local
/artifacts/
*.apk
*.aab
